{
  "name": "adventura-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Modern React/Electron launcher for Adventura.",
  "homepage": "https://github.com/YoungJibbit95/Adventura",
  "author": {
    "name": "YoungJibbit95",
    "email": "youngjibbit95@users.noreply.github.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build-installers.cjs all",
    "build:renderer": "vite build",
    "build:game": "node scripts/prepare-game.cjs",
    "build:setup": "node scripts/build-installers.cjs current",
    "build:setup:all": "node scripts/build-installers.cjs all",
    "build:setup:win": "node scripts/build-installers.cjs win",
    "build:setup:mac": "node scripts/build-installers.cjs mac",
    "build:setup:linux": "node scripts/build-installers.cjs linux",
    "prepare:game": "node scripts/prepare-game.cjs",
    "test:platform": "node scripts/platform-smoke.cjs",
    "dist:dir": "npm run build:renderer && npm run prepare:game && electron-builder --dir",
    "dist:deb": "npm run build:renderer && npm run prepare:game && electron-builder --linux deb",
    "dist": "npm run build:setup",
    "dist:all": "npm run build:setup:all",
    "dist:win": "npm run build:setup:win",
    "dist:mac": "npm run build:setup:mac",
    "dist:linux": "npm run build:setup:linux",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/start-electron.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.2"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "build": {
    "appId": "dev.voxelgame.adventura.launcher",
    "productName": "Adventura Launcher",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/build/install/client",
        "to": "game/client"
      },
      {
        "from": "../server/build/install/server",
        "to": "game/server"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Game",
      "maintainer": "YoungJibbit95 <youngjibbit95@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
